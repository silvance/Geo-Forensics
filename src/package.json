{
  "name": "geoforensics",
  "version": "1.4.0",
  "description": "GeoForensics: free batch image & video geolocation and EXIF forensics tool. Extracts metadata, maps GPS coordinates, and reconstructs event timelines - fully local.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js",
    "test": "node --test",
    "package": "electron-builder --win --publish never",
    "package:mac": "electron-builder --mac --publish never",
    "package:linux": "electron-builder --linux --publish never"
  },
  "author": "Silvance",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvance/Geo-Forensics.git"
  },
  "dependencies": {
    "electron-updater": "6.8.3",
    "exiftool-vendored": "35.20.0",
    "express": "5.2.1",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "electron": "40.4.0",
    "electron-builder": "26.7.0"
  },
  "build": {
    "appId": "com.silvance.geoforensics",
    "productName": "GeoForensics",
    "copyright": "Copyright \u00a9 2026 GeoForensics contributors. Based on Refloow Geo Forensics \u00a9 Veljko Vuckovic",
    "asar": true,
    "asarUnpack": [
      "node_modules/exiftool-vendored/**",
      "node_modules/exiftool-vendored.exe/**",
      "node_modules/exiftool-vendored.pl/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!npm-debug.log*",
      "!**/.git",
      "!**/.vscode",
      "!**/.idea",
      "!**/*.map",
      "!node_modules/.bin/**/*",
      "!node_modules/electron/**/*",
      "!dist/electron/**/*.js"
    ],
    "win": {
      "icon": "img/geoforensics.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "img/geoforensics.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "img/geoforensics.png",
      "target": [
        "AppImage",
        "deb",
        "snap"
      ],
      "category": "Utility",
      "description": "GeoForensics: batch image & video geolocation forensics tool.",
      "maintainer": "Silvance <silvance1@gmail.com>"
    },
    "snap": {
      "summary": "Free batch image & video geolocation digital forensics tool",
      "description": "GeoForensics is a free, open-source digital forensics tool for investigators, OSINT practitioners, and security analysts. It extracts EXIF metadata from batches of images or videos, visualizes GPS data on interactive maps, and reconstructs chronological event timelines. Fully private and local: no data collection, no logins. Fork of Refloow Geo Forensics (AGPL-3.0).",
      "confinement": "strict",
      "plugs": [
        "default",
        "removable-media"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "silvance",
      "repo": "Geo-Forensics"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "license": "LICENSE",
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "img/geoforensics.ico",
      "shortcutName": "GeoForensics",
      "createDesktopShortcut": true,
      "perMachine": false,
      "uninstallDisplayName": "GeoForensics",
      "artifactName": "GeoForensics-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "GeoForensics-Portable-${version}.exe"
    }
  },
  "contributors": [
    "Veljko Vuckovic (author of Refloow Geo Forensics, the original project)"
  ]
}
